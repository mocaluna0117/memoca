# --- Next.js が読む変数（Vercel と .env.local に置く）---

# `pnpm dev:convex` の初回実行で .env.local へ自動的に書かれます。
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# 上と同じデプロイの .site ドメイン。Better Auth の HTTP ルート用。
# 本番では Vercel の環境変数に手で設定します（Convex は自動で入れてくれません）。
NEXT_PUBLIC_CONVEX_SITE_URL=

# 本番の Vercel だけに必要。Convex の関数とアプリを一度にデプロイするための鍵。
# Convex ダッシュボードの Settings → Deploy Keys で発行します。
CONVEX_DEPLOY_KEY=

# --- Convex が読む変数（`npx convex env set` で入れる。ファイルには置かない）---
#
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set GOOGLE_CLIENT_ID ...
#   npx convex env set GOOGLE_CLIENT_SECRET ...
#   npx convex env set ADMIN_EMAILS you@example.com
#
# 本番へ入れるときは末尾に --prod を付けます。
#
# 開発とテストだけで使うもの（本番には設定しないこと）:
#   npx convex env set ALLOW_PASSWORD_AUTH true   # メールとパスワードでのログイン
#   npx convex env set MAX_USERS 100000           # 登録上限の引き上げ
