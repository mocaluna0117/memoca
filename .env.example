# --- Convex（`pnpm dev:convex` の初回実行で自動的に .env.local へ書かれます）---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# 上と同じデプロイの .site ドメイン（Better Auth の HTTP ルート用）
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Next.js ---
# このアプリの公開 URL。ローカルでは http://localhost:3000
SITE_URL=http://localhost:3000

# --- 以下は Convex 側の環境変数として設定します ---
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set GOOGLE_CLIENT_ID ...
#   npx convex env set GOOGLE_CLIENT_SECRET ...
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set ADMIN_EMAILS "you@example.com"
