{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick",
  "description": "The quick note's window, showing Memoca's site: moved by its header, and the app's own five commands. Nothing else, and no other page.",
  "windows": ["quick"],
  "remote": {
    "urls": ["https://memoca-app.vercel.app/*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-hide",
    "allow-open-external",
    "allow-begin-sign-in",
    "allow-complete-sign-in",
    "allow-take-sign-in"
  ]
}
