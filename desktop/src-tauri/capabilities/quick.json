{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick",
  "description": "The quick note's window and Memoca's own, showing Memoca's site: moved by its header, and the app's own eleven commands. Nothing else, and no other site.",
  "windows": ["quick", "app"],
  "remote": {
    "urls": ["https://memoca-app.vercel.app/*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-hide",
    "allow-open-external",
    "allow-begin-sign-in",
    "allow-complete-sign-in",
    "allow-take-sign-in",
    "allow-open-app",
    "allow-show-quick",
    "allow-show-app",
    "allow-copy-images",
    "allow-device-unlock-kind",
    "allow-device-unlock-secret"
  ]
}
