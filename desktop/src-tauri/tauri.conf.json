{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoca",
  "version": "0.3.1",
  "identifier": "io.github.mocaluna0117.memoca",
  "build": {
    "frontendDist": "https://memoca-app.vercel.app"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Memoca の即席メモ",
    "copyright": "Copyright (c) 2026 mocaluna0117",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "memoca"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCOURBM0QxNDNFQzc2NkYKUldSdmR1eEQwYU9kSzFrUkxnODJ3TlR4VUEvOVdvYThXMnVkM3BxVlBnanZNaWluR2xnZE5wd1EK",
      "endpoints": [
        "https://github.com/mocaluna0117/memoca/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
