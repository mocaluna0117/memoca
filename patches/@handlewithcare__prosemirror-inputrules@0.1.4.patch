diff --git a/dist/inputrules.js b/dist/inputrules.js
index 6845d468baf8525800b086694432333c4e9c1277..0fbf4385c7ba1a4430665f8099d5fa2b9ac3894e 100644
--- a/dist/inputrules.js
+++ b/dist/inputrules.js
@@ -117,14 +117,38 @@ function run(view, from, to, text, rules, plugin) {
         let tr = rule.handler(state, match, mappedFrom - match[0].length, mappedTo);
         if (!tr)
             continue;
+        // Memoca: Yjs's undo (y-prosemirror's, in place of ProseMirror's
+        // history) knows nothing of closeHistory, and takes what comes
+        // within half a second as one step: ⌘Z just after "- " made a list
+        // took the "- " typed with it, leaving an empty line. The typed
+        // text ends its step before the rule's change, which is undone
+        // alone. A rule run by Enter is handed a line break as its text
+        // (see below), not one to be left in the line: the step ends
+        // before it instead, and it is undone with the rule's change.
+        const yUndo = view.state.plugins
+            .find((each) => each.key === "y-undo$")
+            ?.getState(view.state)?.undoManager;
+        if (text === "\n")
+            yUndo?.stopCapturing();
         view.dispatch(insertTr);
         view.dispatch(closeHistory(view.state.tr));
+        if (text !== "\n")
+            yUndo?.stopCapturing();
         if (rule.undoable)
             tr.setMeta(plugin, {
                 transform: tr,
-                from: mappedFrom,
+                // Memoca: the line break BlockNote's Enter hands the rules
+                // (to run them on Enter as on a space) is not one to keep:
+                // undone, the rule takes it too, from where it went in.
+                // Kept, it stayed as a "\n" in the line's text: - and Enter,
+                // then Backspace, left "-\n".
+                from: text === "\n" ? from : mappedFrom,
                 to: mappedTo,
-                text,
+                // Memoca: the typed text was dispatched on its own above, so
+                // undoing the rule leaves it there already. Told it here,
+                // undoInputRule (this package's and tiptap's) put it in a
+                // second time: "- " came back as "-  ", ・ as ・・.
+                text: "",
             });
         view.dispatch(tr);
         return true;
